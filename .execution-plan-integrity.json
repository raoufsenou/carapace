{
  "$schema": "./skills/execution-plan-integrity/assets/execution-plan-integrity.schema.json",
  "schema": 2,
  "canonical": "docs/execution-plan.md",
  "profile": "backend",
  "completionProofs": {
    "directory": "docs/execution-proofs"
  },
  "requiredGlobs": ["docs/**/*plan*.md", "docs/**/*audit*.md"],
  "roles": {
    "evidence": ["docs/**/*audit*.md"],
    "validation": ["docs/**/*validation*.md"],
    "design": ["docs/**/*design*.md"],
    "archive": ["docs/archive/**/*.md"]
  },
  "agents": {
    "tiers": {
      "advisor": { "effort": "medium" },
      "light": { "effort": "low" },
      "medium": { "effort": "medium" },
      "careful": { "effort": "high" },
      "heavy": { "effort": "xhigh" },
      "fable": { "effort": "max" }
    },
    "packageManager": "pnpm",
    "extraRules": [
      "Never run live scripts/install.mjs --replace against user home directories; temp-dir tests only."
    ]
  }
}
